# Copy to the root .env if it does not already exist. Never overwrite a configured .env.
# Native API, web and optional Docker tools share that one ignored file.
# Vite exposes only VITE_ names. Keep all secrets unprefixed.

# Native API and authentication
ConnectionStrings__DefaultConnection=Server=.;Database=UniPMDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True
UNIPM_JWT_ISSUER=UniPM.Local
UNIPM_JWT_AUDIENCE=UniPM.Local.Clients
UNIPM_JWT_ACCESS_TOKEN_MINUTES=15
UNIPM_JWT_SIGNING_KEY=ChangeThisLocalJwtSigningKey-AtLeast32Bytes!
UNIPM_DEV_USER_PASSWORD=
UNIPM_AUTH_REFRESH_TOKEN_DAYS=7
UNIPM_WEB_ORIGIN=http://localhost:5173

# Web client: only VITE_ variables are exposed to the browser
VITE_API_BASE_URL=http://localhost:5000

# Development analytics providers: backend/evaluator only
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional Docker database and observability
MSSQL_SA_PASSWORD=ChangeThisLocalPassword123!
UNIPM_DB_NAME=UniPMDb
UNIPM_DB_PORT=1433
UNIPM_API_PORT=5000
UNIPM_METRICS_ENABLED=true
UNIPM_PROMETHEUS_PORT=9090
UNIPM_GRAFANA_PORT=3000
UNIPM_GRAFANA_ADMIN_USER=admin
UNIPM_GRAFANA_ADMIN_PASSWORD=ChangeThisLocalGrafanaPassword123!

# Optional retained reference embeddings
UNIPM_EMBEDDINGS_ENABLED=false
UNIPM_EMBEDDINGS_PROVIDER_KEY=
UNIPM_EMBEDDINGS_BASE_ADDRESS=
UNIPM_EMBEDDINGS_PATH=/v1/embeddings
UNIPM_EMBEDDINGS_MODEL=
UNIPM_EMBEDDINGS_API_KEY=
UNIPM_EMBEDDINGS_DIMENSIONS=
UNIPM_EMBEDDINGS_TIMEOUT_SECONDS=30
UNIPM_EMBEDDINGS_MAX_BATCH_SIZE=16
UNIPM_EMBEDDINGS_MAX_INPUT_CHARACTERS=4000
UNIPM_EMBEDDINGS_ALLOW_REMOTE_PROVIDER=false

# Docker overrides: retain differences from native settings
# UNIPM_DOCKER_MSSQL_SA_PASSWORD=
# UNIPM_DOCKER_JWT_ACCESS_TOKEN_MINUTES=
# UNIPM_DOCKER_DEV_USER_PASSWORD=
# UNIPM_DOCKER_EMBEDDINGS_ENABLED=
# UNIPM_DOCKER_EMBEDDINGS_PROVIDER_KEY=
# UNIPM_DOCKER_EMBEDDINGS_BASE_ADDRESS=
# UNIPM_DOCKER_EMBEDDINGS_MODEL=
# UNIPM_DOCKER_EMBEDDINGS_API_KEY=
# UNIPM_DOCKER_EMBEDDINGS_DIMENSIONS=
# UNIPM_DOCKER_EMBEDDINGS_ALLOW_REMOTE_PROVIDER=

# Omitted Docker overrides inherit ordinary settings; explicit empty values remain empty.
# For embeddings, keep remote calls disabled unless deliberately configured.
