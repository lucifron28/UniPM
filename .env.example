# Native local configuration for UniPM.
# SQL Server 2019 is the default and requires Full-Text Search plus compatibility level 150.
ConnectionStrings__DefaultConnection=Server=.;Database=UniPMDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True

# scripts/start-server.ps1 imports the connection and JWT settings from .env.
# The API and evaluation tool do not load .env automatically. Import values into
# the process when launching either directly.
UNIPM_JWT_ISSUER=UniPM.Local
UNIPM_JWT_AUDIENCE=UniPM.Local.Clients
UNIPM_JWT_ACCESS_TOKEN_MINUTES=15
# Supply a signing key of at least 32 UTF-8 bytes in the local .env or process.
UNIPM_JWT_SIGNING_KEY=

# Required only when running the Development-user seed command. Set it in that
# process; do not put a real password in this template.
UNIPM_DEV_USER_PASSWORD=

# Development-only keys for bounded synthetic v2 analytics evaluation.
# The evaluator reads these from its process. Provider models and settings are
# fixed in the evaluator; the application runtime does not use these keys.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional SQL Server 2019 integration tests read
# UNIPM_SQLSERVER2019_TEST_CONNECTION from their process environment.
# Keep that connection string out of this file.
# Optional SQL Server 2025 Docker, embedding, and observability settings are in
# .env.sqlserver2025.example. They are not needed for native local development.
