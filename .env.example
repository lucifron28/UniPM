# Native Windows SQL Server 2019 is the default UniPM local database path.
# This repository does not load .env automatically; set these values only in
# the process that runs UniPM and never commit local connection strings or keys.
#
# Preferred Windows Authentication example:
# $env:ConnectionStrings__DefaultConnection =
#   "Server=.;Database=UniPMDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
#
# Named-instance example:
# $env:ConnectionStrings__DefaultConnection =
#   "Server=localhost\INSTANCE_NAME;Database=UniPMDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
#
# SQL Server 2019 requires Full-Text Search and compatibility level 150.
# Keep the Development-user password process-scoped and never commit it:
# $env:UNIPM_DEV_USER_PASSWORD = "<temporary-development-password>"
#
# SQL integration tests use process-only values as well:
# $env:UNIPM_SQLSERVER_TEST_CONNECTION = "<native SQL Server test connection>"
# $env:UNIPM_SQLSERVER2019_TEST_CONNECTION = "<native SQL Server 2019 master/test connection>"
#
# Optional legacy Docker SQL Server 2025 experiments use
# .env.sqlserver2025.example with docker-compose.sqlserver2025.yml. They are
# not required for local development, testing, IIS deployment, or production.
