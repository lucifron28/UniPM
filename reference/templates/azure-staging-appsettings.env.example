# Safe value template for Azure App Service configuration. Replace placeholders
# in the portal. Do not copy secrets into this file or commit a filled copy.
# Do not add demo-seeding credentials or staging initialization flags here.
# Those belong only in the trusted operator process, through hidden prompts.
# See reference/guides/azure-staging-deployment.md for independent credentials
# and the explicitly approved temporary shared-password option.
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=REPLACE_WITH_VERIFIED_APP_HOSTNAME
ConnectionStrings__DefaultConnection=Server=tcp:sql-unipm-staging.database.windows.net,1433;Initial Catalog=unipm-staging-db;User ID=REPLACE_WITH_SQL_LOGIN;Password=REPLACE_WITH_EXTERNAL_SECRET;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
UNIPM_JWT_ISSUER=UniPM.AzureStaging
UNIPM_JWT_AUDIENCE=UniPM.AzureStaging.Clients
UNIPM_JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
UNIPM_WEB_ORIGIN=https://REPLACE_WITH_VERIFIED_APP_HOSTNAME
InspectionPhotoEvidence__StorageProvider=AzureBlob
InspectionPhotoEvidence__BlobServiceUri=https://REPLACE_WITH_EXISTING_STORAGE_ACCOUNT.blob.core.windows.net/
Embeddings__Enabled=false
NaturalLanguageAnalytics__Enabled=false
# Generate missing current-year CPMP cycles at app startup and daily while running.
# Past cycles remain subject to GSD-approved ScheduleGeneration__EffectiveDate.
PreventiveMaintenanceScheduleGeneration__WorkerEnabled=true
Observability__MetricsEnabled=false
